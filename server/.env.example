# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/soccer_analysis

# Security & Auth
# CLIENT_ORIGIN is the URL of your frontend (e.g., https://your-site.netlify.app)
CLIENT_ORIGIN=http://localhost:5173

# Admin Configuration (comma-separated list)
# ADMIN_EMAILS=admin@example.com,super@example.com
# APPROVED_EMAILS=user1@example.com,user2@example.com
# APPROVED_DOMAIN=example.com

# Quota Configuration (Minutes)
DAILY_QUOTA=100
WEEKLY_QUOTA=400
MONTHLY_QUOTA=1200
